Split tunneling requires cgroup v2, systemd user scopes, and iptables cgroup
matching. Applications must be launched with "oniongate split run"; existing
processes and ordinary launches are not covered. Include mode leaves other
system traffic direct. Tor carries TCP and DNS for selected apps; unsupported
public non-TCP traffic and included-app IPv6 traffic are blocked. Local/private destinations
may remain direct. Apps that delegate networking to separate system services may
not be covered. Split rules are inactive unless explicitly enabled.
"split apply" validates prerequisites; changes take effect on the next start.

NOTE:
    A new circuit does not guarantee a different public exit IP.

CONFIGURATION:
    Edit /etc/oniongate/oniongate.conf to add your bridge lines.
    
    Example bridge formats:
    
    obfs4:
    obfs4 IP:PORT FINGERPRINT cert=CERT iat-mode=0
    
    snowflake:
    snowflake IP:PORT FINGERPRINT fingerprint=FP url=URL fronts=FRONTS ice=STUN utls-imitate=TYPE
    
    meek_lite:
    meek_lite IP:PORT url=URL front=FRONT utls=TYPE

DEPENDENCIES:
    - tor: Debian: sudo apt install tor  |  Arch: sudo pacman -S tor
    - obfs4proxy: Debian: sudo apt install obfs4proxy  |  Arch: sudo pacman -S obfs4proxy
    - snowflake-client: Debian: sudo apt install snowflake-client  |  Arch: sudo pacman -S snowflake

For more information, see: https://bridges.torproject.org
EOF
    fi
    if [[ -f "/etc/oniongate/help.txt" ]]; then
        echo ""
        echo "ADDITIONAL COMMAND:"
        echo "    oniongate diagnostics"
        echo "        Read Tor bootstrap/circuits, test DNS, and measure bounded SOCKS downloads."
        echo "        Add --compare-direct to send a baseline outside Tor to the test endpoint."
        echo "    oniongate proxy {start|stop|reconnect|status|refresh|diagnostics}"
        echo "        Manage the separate GOST TCP proxy; DNS and UDP are not proxied."
        echo "    oniongate split {status|apps|rules|enable|disable|mode|include|exclude|remove|run|apply}"
        echo "        Route selected applications only inside an OnionGate systemd cgroup scope."
        echo "        'split apply' validates settings for the next start; it does not change live firewall rules."
        echo ""
        echo "Download tests default to 1 MiB, three sequential samples, and a 20-second per-download timeout."
        echo "    ONIONGATE_DIAGNOSTICS_URL (HTTPS only)"
        echo "    ONIONGATE_DIAGNOSTICS_BYTES (65536 through 10485760)"
        echo "    ONIONGATE_DIAGNOSTICS_SAMPLES (1 through 5)"
        echo ""
        echo "Split routing requires cgroup v2, systemd user scopes, and iptables cgroup support."
        echo "Only TCP/DNS can use Tor; selected-app public non-TCP and IPv6 are blocked, and"
        echo "local/private destinations may remain direct. Use 'split run' to launch apps."
        echo "Apps that delegate networking to separate services may not be covered."
    fi
    echo ""
}

cmd_uninstall() {
    show_banner
    
    check_root
    
    log_info "Uninstalling OnionGate..."
    
    cmd_proxy_stop || return 1
    stop_tor || return 1
    restore_all_backups || return 1
    rm -f -- "$STATUS_FILE"
    
    log_info "Removing OnionGate files..."
    rm -f /usr/local/bin/oniongate
    rm -f /usr/local/bin/oniongate-gui
    rm -f /usr/local/sbin/oniongate-uninstall
    rm -f /usr/local/share/applications/oniongate.desktop
    rm -f /usr/local/lib/oniongate/tor_control.py
    rmdir /usr/local/lib/oniongate 2>/dev/null || true
    rm -rf /opt/oniongate/gui /opt/oniongate/venv /opt/oniongate/assets
    rmdir /opt/oniongate 2>/dev/null || true
    
    log_success "OnionGate has been uninstalled"
    log_info "Configuration and data were preserved at $ONIONGATE_DIR"
    log_info "Note: Tor, obfs4proxy, and snowflake-client were not removed"
}

# ============================================
# Main Entry Point
# ============================================
main() {
    local command_name="${1:-}"
    case "$command_name" in
        start|restart)
                local requested_command="$command_name"
                shift
                bridge_type=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -o|--obfs4)
                        bridge_type="obfs4"
                        ;;
                    -s|--snowflake)
                        bridge_type="snowflake"
                        ;;
                    -m|--meek)
                        bridge_type="meek"
                        ;;
                    --country)
                        if [[ $# -lt 2 || -z "$2" ]]; then
                            log_error "--country requires a two-letter country code"
                            exit 1
                        fi
                        EXIT_COUNTRY="${2,,}"
                        if [[ ! "$EXIT_COUNTRY" =~ ^[a-z]{2}$ ]]; then
                            log_error "Invalid country code: $2 (expected two letters)"
                            exit 1
                        fi
                        shift
                        ;;
                    -v|--verbose)
                        VERBOSE=true
                        ;;
                    --spoof-mac)
                        SPOOF_MAC=true
                        ;;
                    *)
                        log_error "Unknown option: $1"
                        exit 1
                        ;;
                esac
                shift
            done
            if [[ "$requested_command" == "restart" ]]; then
                check_root
                stop_tor || exit 1
                restore_all_backups || exit 1
                rm -f -- "$STATUS_FILE"
                rm -f -- "$REFRESH_TIMESTAMP"
            fi
            cmd_start "$bridge_type"
            ;;
        stop)
            cmd_stop
            ;;
        status)
            cmd_status
            ;;
        split)
            shift
            cmd_split "$@"
            ;;
        diagnostics)
            shift
            cmd_diagnostics "$@"
            ;;
        proxy)
            shift
            cmd_proxy "$@"
            ;;
        refresh)
            cmd_refresh
            ;;
        version)
            cmd_version
            ;;
        help|--help|-h)
            cmd_help
            ;;
        uninstall)
            cmd_uninstall
            ;;
        *)
            show_banner
            if [[ -n "$1" ]]; then
                log_error "Unknown command: $1"
            fi
            echo "USAGE:"
            echo "    oniongate <command> [options]"
            echo ""
            echo "COMMANDS:"
            echo "    start           Start OnionGate (direct mode)"
    echo "    stop            Stop OnionGate and remove its owned rules"
            echo "    restart         Stop and start OnionGate"
            echo "    status          Show OnionGate status"
            echo "    diagnostics     Show Tor bootstrap, circuits, and performance measurements"
            echo "    refresh         Request a new Tor circuit (exit IP may remain unchanged)"
            echo "    split           Configure cgroup-scoped application split tunneling"
            echo "    proxy           Manage the independent GOST high-speed proxy backend"
            echo "    version         Show version information"
            echo "    help            Show instructions"
            echo "    uninstall       Remove OnionGate from system"
            echo ""
            echo "OPTIONS (used with start):"
            echo "    -o, --obfs4     Start OnionGate using obfs4 bridge"
            echo "    -s, --snowflake Start OnionGate using snowflake bridge"
            echo "    -m, --meek      Start OnionGate using meek_lite bridge"
            echo "    --country CODE Prefer Tor exits in the specified two-letter country"
            echo "    -v, --verbose   Show full Tor log output"
            echo "    --spoof-mac     Opt in to temporary MAC address changes (may disrupt connectivity)"
            echo ""
            echo "EXAMPLES:"
            echo "    oniongate start"
            echo "    oniongate start --obfs4"
            echo "    oniongate start -s"
            echo "    oniongate start -v"
            echo "    oniongate stop"
            echo "    oniongate diagnostics"
            echo "    oniongate refresh"
            echo "    sudo oniongate proxy start"
            echo "    sudo oniongate proxy diagnostics"
            exit 1
            ;;
    esac
}

main "$@"
