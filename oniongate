append_country_preference() {
    if [[ -n "$EXIT_COUNTRY" ]]; then
        printf 'ExitNodes {%s}\n' "$EXIT_COUNTRY" >> "$TORRC_FILE"
        log_info "Tor exit-country preference set to: $EXIT_COUNTRY"
    fi
