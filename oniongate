stop_log_display() {
    if [[ -n "$LOG_TAIL_PID" ]]; then
        pkill -P "$LOG_TAIL_PID" 2>/dev/null
        kill "$LOG_TAIL_PID" 2>/dev/null
        wait "$LOG_TAIL_PID" 2>/dev/null
        LOG_TAIL_PID=""
    fi
    [[ "$VERBOSE" != "true" ]] && printf '\r\033[K'
}

# ============================================
# Signal Handling
# ============================================
cleanup_on_interrupt() {
    echo ""
    log_warning "Interrupted! Rolling back OnionGate changes..."
    exit 130
}

cleanup_on_exit() {
    local exit_status=$?
    trap - EXIT INT TERM
    if [[ "$STARTUP_IN_PROGRESS" == "true" ]]; then
        STARTUP_IN_PROGRESS=false
        stop_log_display || true
        stop_tor || log_error "Tor process cleanup failed; inspect $ONIONGATE_DIR/tor.pid"
        restore_all_backups || log_error "Some OnionGate state could not be restored"
        rm -f -- "$STATUS_FILE"
    fi
    exit "$exit_status"
}

