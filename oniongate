# ============================================
# Colors
# ============================================
WHITE='\033[1;37m'
GREEN='\033[0;32m'
RED='\033[0;31m'
ORANGE='\033[0;33m'
NC='\033[0m'

# ============================================
# Utility Functions
# ============================================
log_info() {
    printf '\r\033[K'
    echo -e "${WHITE}[*] $1${NC}"
}

log_success() {
    printf '\r\033[K'
    echo -e "${GREEN}[+] $1${NC}"
}

log_error() {
    printf '\r\033[K'
    echo -e "${RED}[-] $1${NC}"
}

log_warning() {
    printf '\r\033[K'
    echo -e "${ORANGE}[!] $1${NC}"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This script must be run as root"
        echo "    Usage: sudo oniongate <command>"
        exit 1
    fi
}

detect_distribution() {
    if [[ ! -r /etc/os-release ]]; then
        log_error "Cannot identify this Linux distribution (/etc/os-release missing)"
        return 1
    fi
    . /etc/os-release
    local ids=" ${ID:-} ${ID_LIKE:-} "
    ids="${ids,,}"
    case "$ids" in
        *debian*|*ubuntu*|*linuxmint*|*kali*|*pop*|*zorin*|*raspbian*) DISTRO_FAMILY="debian" ;;
        *arch*|*manjaro*|*endeavouros*|*artix*) DISTRO_FAMILY="arch" ;;
        *) log_error "Unsupported distribution: ${PRETTY_NAME:-unknown}. Supported families: Debian and Arch."; return 1 ;;
    esac
    return 0
}

detect_tor_user() {
    if id debian-tor >/dev/null 2>&1; then
        TOR_USER="debian-tor"
    elif id tor >/dev/null 2>&1; then
        TOR_USER="tor"
    else
        TOR_USER=""
        TOR_UID=""
        return 1
    fi
    TOR_UID=$(id -u "$TOR_USER")
    TOR_GROUP=$(id -gn "$TOR_USER")
    return 0
}

is_oniongate_tor_pid() {
    local pid="$1"
    local command_line
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [[ -r "/proc/$pid/cmdline" ]] || return 1
    command_line=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    [[ "$command_line" == *"tor -f $TORRC_FILE"* ]]
}

is_running() {
    [[ -r "$ONIONGATE_DIR/tor.pid" ]] || return 1
    is_oniongate_tor_pid "$(<"$ONIONGATE_DIR/tor.pid")"
}

tor_firewall_is_active() {
    (command -v iptables >/dev/null 2>&1 &&
        { iptables -t nat -C OUTPUT -m comment --comment OnionGate-managed \
            -j ONIONGATE_NAT >/dev/null 2>&1 ||
          iptables -C OUTPUT -m comment --comment OnionGate-managed \
            -j ONIONGATE_OUT >/dev/null 2>&1; }) ||
    (command -v ip6tables >/dev/null 2>&1 &&
        ip6tables -C OUTPUT -m comment --comment OnionGate-managed \
            -j ONIONGATE6_OUT >/dev/null 2>&1)
}

# ============================================
# Dependency Management
# ============================================
check_dependencies() {
    local missing=()
    local required=(tor curl dig ip python3 iptables ip6tables runuser id flock ss)
    local cmd
    for cmd in "${required[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_warning "Missing dependencies: ${missing[*]}"
        return 1
    fi
    if [[ "$ACTIVE_BRIDGE" == "obfs4" || "$ACTIVE_BRIDGE" == "meek" ]]; then
        command -v obfs4proxy >/dev/null 2>&1 || missing+=(obfs4proxy)
    elif [[ "$ACTIVE_BRIDGE" == "snowflake" ]]; then
        if ! command -v snowflake-client >/dev/null 2>&1 && ! command -v snowflake >/dev/null 2>&1; then missing+=(snowflake-client); fi
    fi
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_warning "Missing dependencies: ${missing[*]}"
        return 1
    fi
    detect_tor_user || { log_error "Tor service account (debian-tor or tor) was not found"; return 1; }
    return 0
}

install_dependencies() {
    log_info "Installing dependencies for ${DISTRO_FAMILY}..."
    if [[ "$DISTRO_FAMILY" == "debian" ]]; then
        apt-get update -qq
        apt-get install -y tor curl dnsutils python3 iproute2 iptables ca-certificates util-linux
        if [[ "$ACTIVE_BRIDGE" == "obfs4" || "$ACTIVE_BRIDGE" == "meek" ]]; then apt-get install -y obfs4proxy; fi
        if [[ "$ACTIVE_BRIDGE" == "snowflake" ]]; then apt-get install -y snowflake-client; fi
    elif [[ "$DISTRO_FAMILY" == "arch" ]]; then
        pacman -Syu --needed --noconfirm tor curl bind-tools python iproute2 iptables ca-certificates util-linux
        if [[ "$ACTIVE_BRIDGE" == "obfs4" || "$ACTIVE_BRIDGE" == "meek" ]]; then pacman -S --needed --noconfirm obfs4proxy; fi
        if [[ "$ACTIVE_BRIDGE" == "snowflake" ]]; then pacman -S --needed --noconfirm snowflake; fi
    else
        log_error "Distribution has not been detected"
        return 1
    fi
    log_success "Dependency installation completed"
}

# ============================================
# Backup Functions
# ============================================
create_backup_dir() {
    [[ ! -L "$ONIONGATE_DIR" && ! -L "$BACKUP_DIR" && ! -L "$ONIONGATE_DIR/data" ]] || {
        log_error "OnionGate configuration paths must not be symbolic links"
        return 1
    }
    local path
    for path in "$TORRC_FILE" "$TOR_LOG" "$STATUS_FILE" "$ONIONGATE_DIR/tor.pid" \
        "$REFRESH_LOCK" "$REFRESH_TIMESTAMP" "$TOR_CONTROL_COOKIE"; do
        [[ ! -L "$path" ]] || {
            log_error "Refusing to use symbolic-link runtime path: $path"
            return 1
        }
    done
    install -d -o root -g "$TOR_GROUP" -m 0755 "$ONIONGATE_DIR"
    install -d -o root -g root -m 0700 "$BACKUP_DIR"
    install -d -o "$TOR_USER" -g "$TOR_GROUP" -m 0700 "$ONIONGATE_DIR/data"
}

backup_resolv() {
    # OnionGate no longer overwrites /etc/resolv.conf; DNS is redirected by its own NAT chain.
    log_info "Leaving system DNS configuration unchanged"
}

backup_mac_addresses() {
    log_info "Recording network interface addresses..."
    : > "$MAC_BACKUP"
    if [[ "$SPOOF_MAC" == "true" ]]; then
        for iface in $(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -v '^lo$'); do
            mac=$(ip -o link show dev "$iface" | awk '{for(i=1;i<=NF;i++) if($i=="link/ether") print $(i+1)}')
            [[ -n "$mac" ]] && printf '%s:%s\n' "$iface" "$mac" >> "$MAC_BACKUP"
        done
    fi
    log_success "Original interface addresses recorded"
}

backup_torrc() {
    [[ ! -L "$TORRC_FILE" ]] || {
        log_error "Refusing to replace symbolic-link Tor configuration: $TORRC_FILE"
        return 1
    }
    rm -f -- "$TORRC_BACKUP" "$BACKUP_DIR/torrc.was-absent" "$BACKUP_DIR/torrc.existed"
    if [[ -e "$TORRC_FILE" ]]; then
        cp -a -- "$TORRC_FILE" "$TORRC_BACKUP"
        : > "$BACKUP_DIR/torrc.existed"
    else
        : > "$BACKUP_DIR/torrc.was-absent"
    fi
}

create_all_backups() {
    create_backup_dir
    backup_resolv
    backup_torrc
    backup_mac_addresses
}

# ============================================
# Restore Functions
# ============================================
restore_iptables() {
    log_info "Removing only OnionGate firewall rules..."
    remove_oniongate_firewall || return 1
    log_success "OnionGate firewall rules removed; unrelated rules were left untouched"
}

restore_resolv() {
    log_info "System DNS configuration was not modified"
}

restore_torrc() {
    [[ ! -L "$TORRC_FILE" ]] || {
        log_error "Refusing to restore Tor configuration through a symbolic link"
        return 1
    }
    if [[ -f "$BACKUP_DIR/torrc.existed" ]]; then
        cp -a -- "$TORRC_BACKUP" "$TORRC_FILE"
    elif [[ -f "$BACKUP_DIR/torrc.was-absent" ]]; then
        rm -f -- "$TORRC_FILE"
    fi
}

restore_mac_addresses() {
    # Restore MAC addresses only if the user explicitly requested spoofing for this run.
    if [[ -s "$MAC_BACKUP" ]]; then
        local failed=0
        log_info "Restoring recorded interface addresses..."
        while IFS=: read -r iface mac; do
            [[ -n "$iface" && -n "$mac" ]] || continue
            if ! ip link show dev "$iface" >/dev/null 2>&1; then
                log_warning "Interface $iface no longer exists"
                failed=1
                continue
            fi
            if ! ip link set dev "$iface" down ||
               ! ip link set dev "$iface" address "$mac" ||
               ! ip link set dev "$iface" up; then
                log_error "Could not fully restore the original address for $iface"
                ip link set dev "$iface" up || true
                failed=1
            fi
        done < "$MAC_BACKUP"
        [[ "$failed" == "0" ]] || return 1
    fi
    log_success "Interface address restoration complete"
}

restore_all_backups() {
    restore_iptables || return 1
    restore_resolv || return 1
    restore_torrc || return 1
    restore_mac_addresses || return 1
    rm -f -- "$MAC_BACKUP" "$TORRC_BACKUP" \
        "$BACKUP_DIR/torrc.existed" "$BACKUP_DIR/torrc.was-absent"
    rmdir "$BACKUP_DIR" 2>/dev/null || true
    log_success "OnionGate startup state restored without replacing system firewall rules"
}

# ============================================
# MAC Address Spoofing
# ============================================
generate_random_mac() {
    printf '02:%02x:%02x:%02x:%02x:%02x\n' \
        $((RANDOM % 256)) $((RANDOM % 256)) \
        $((RANDOM % 256)) $((RANDOM % 256)) \
        $((RANDOM % 256))
}

spoof_mac_addresses() {
    log_info "Spoofing MAC addresses..."
    local failed=0
    for iface in $(ip -o link show | awk -F': ' '{print $2}' | grep -v lo); do
        if ip link show "$iface" | grep -q "state UP"; then
            new_mac=$(generate_random_mac)
            if ! ip link set "$iface" down; then
                log_error "Could not bring $iface down for MAC address spoofing"
                failed=1
                continue
            fi
            if ! ip link set "$iface" address "$new_mac"; then
                log_error "Could not change MAC address for $iface"
                ip link set "$iface" up || true
                failed=1
                continue
            fi
            if ! ip link set "$iface" up; then
                log_error "Could not bring $iface back up after changing its MAC address"
                failed=1
                continue
            fi
            log_info "  $iface -> $new_mac"
        fi
    done
    [[ "$failed" == "0" ]] || return 1
    log_success "MAC addresses spoofed"
}

# ============================================
# IPv6 Management
# ============================================
disable_ipv6() {
    log_info "Applying OnionGate IPv6 leak protection..."
    split_load_settings || return 1
    if ip6tables -t filter -S ONIONGATE6_OUT >/dev/null 2>&1; then
        if ! ip6tables -t filter -C ONIONGATE6_OUT \
            -m comment --comment OnionGate-owned -j REJECT >/dev/null 2>&1; then
            log_error "The ONIONGATE6_OUT chain exists but is not marked as OnionGate-owned"
            return 1
        fi
        enable_ipv6 || return 1
    fi
    ip6tables -t filter -N ONIONGATE6_OUT || return 1
    IP6TABLES_CHAIN_CREATED=true
    ip6tables -t filter -A ONIONGATE6_OUT -o lo \
        -m comment --comment OnionGate-managed -j RETURN || return 1
    ip6tables -t filter -A ONIONGATE6_OUT -p udp --sport 546 --dport 547 \
        -d ff02::1:2/128 -m comment --comment OnionGate-managed -j RETURN || return 1
    ip6tables -t filter -A ONIONGATE6_OUT -p ipv6-icmp --icmpv6-type 133 \
        -m comment --comment OnionGate-managed -j RETURN || return 1
    ip6tables -t filter -A ONIONGATE6_OUT -p ipv6-icmp --icmpv6-type 135 \
        -m comment --comment OnionGate-managed -j RETURN || return 1
    ip6tables -t filter -A ONIONGATE6_OUT -p ipv6-icmp --icmpv6-type 136 \
        -m comment --comment OnionGate-managed -j RETURN || return 1
    if [[ -n "$TOR_UID" ]]; then
        ip6tables -t filter -A ONIONGATE6_OUT -m owner --uid-owner "$TOR_UID" \
            -m comment --comment OnionGate-managed -j RETURN || return 1
    fi
    if [[ "$SPLIT_ENABLED" == "true" && "$SPLIT_MODE" == "include" ]]; then
        ip6tables -t filter -A ONIONGATE6_OUT \
            -m comment --comment OnionGate-managed -j RETURN || return 1
    fi
    ip6tables -t filter -A ONIONGATE6_OUT \
        -m comment --comment OnionGate-owned -j REJECT || return 1
    ip6tables -t filter -I OUTPUT 1 \
        -m comment --comment OnionGate-managed -j ONIONGATE6_OUT || return 1
    IP6TABLES_CHAIN_CREATED=false
    if [[ "$SPLIT_ENABLED" == "true" && "$SPLIT_MODE" == "include" ]]; then
        log_warning "General IPv6 traffic remains direct; IPv6 is blocked only for included application scopes."
    else
        log_success "Unsupported IPv6 output is blocked by OnionGate-owned rules; IPv6 remains enabled"
    fi
}

enable_ipv6() {
    remove_owned_chain ip6tables filter OUTPUT ONIONGATE6_OUT REJECT "$IP6TABLES_CHAIN_CREATED"
}

# ============================================
