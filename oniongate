# ============================================
# Tor Service Management
# ============================================
start_tor() {
    log_info "Starting OnionGate-managed Tor process..."
    mkdir -p "$ONIONGATE_DIR/data"
    chown -R "$TOR_USER:$TOR_USER" "$ONIONGATE_DIR/data"
    chmod 700 "$ONIONGATE_DIR/data"
    chown "$TOR_USER:$TOR_USER" "$TORRC_FILE"
    chmod 600 "$TORRC_FILE"
    tor --verify-config -f "$TORRC_FILE" >/dev/null || { log_error "Tor configuration validation failed"; return 1; }
    : > "$TOR_LOG"
    chown "$TOR_USER:$TOR_USER" "$TOR_LOG"
    if [[ "$VERBOSE" == "true" ]]; then
        runuser -u "$TOR_USER" -- tor -f "$TORRC_FILE" &
    else
        runuser -u "$TOR_USER" -- tor -f "$TORRC_FILE" >> "$TOR_LOG" 2>&1 &
    fi
    TOR_PID=$!
    log_info "Waiting for Tor to bootstrap..."
    if [[ "$VERBOSE" != "true" ]]; then
        ( tail -n 0 -f "$TOR_LOG" 2>/dev/null | while IFS= read -r line; do printf '\r\033[K    %.*s' 120 "$line"; done ) &
        LOG_TAIL_PID=$!
    fi
    local timeout=180 elapsed=0 check_result=""
    while [[ $elapsed -lt $timeout ]]; do
        if ! kill -0 "$TOR_PID" 2>/dev/null; then stop_log_display; log_error "OnionGate Tor process exited unexpectedly"; return 1; fi
        check_result=$(curl -fsS --socks5-hostname "127.0.0.1:$TOR_SOCKS_PORT" --max-time 10 https://check.torproject.org/api/ip 2>/dev/null || true)
        if grep -q '"IsTor":true' <<< "$check_result"; then
            stop_log_display
            printf '%s\n' "$TOR_PID" > "$ONIONGATE_DIR/tor.pid"
            log_success "Tor successfully connected"
            local tor_ip
            tor_ip=$(sed -n 's/.*"IP":"\([^"]*\)".*/\1/p' <<< "$check_result")
            [[ -n "$tor_ip" ]] && log_success "Tor exit IP: $tor_ip"
            return 0
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    stop_log_display
    log_error "Tor failed to bootstrap within ${timeout}s"
    stop_tor
    return 1
}

stop_tor() {
    log_info "Stopping only the Tor process started by OnionGate..."
    if [[ -f "$ONIONGATE_DIR/tor.pid" ]]; then
        local pid
        pid=$(cat "$ONIONGATE_DIR/tor.pid")
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null || true
            for _ in {1..10}; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
            kill -KILL "$pid" 2>/dev/null || true
        fi
        rm -f "$ONIONGATE_DIR/tor.pid"
    fi
    rm -f "$TOR_LOG"
    log_success "OnionGate Tor process stopped"
}

# ============================================
# Bridge Validation
# ============================================
validate_bridge_config() {
    local bridge_type="$1"
    
    if [[ -z "$bridge_type" ]]; then
        return 0
    fi
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        return 1
    fi
    
    local bridge_lines=""
    local bridge_display_name=""
    
    case "$bridge_type" in
        obfs4)
            bridge_lines=$(grep -iE "^[[:space:]]*obfs4[[:space:]]+" "$CONFIG_FILE")
            bridge_display_name="obfs4"
            ;;
        snowflake)
            bridge_lines=$(grep -iE "^[[:space:]]*snowflake[[:space:]]+" "$CONFIG_FILE")
            bridge_display_name="snowflake"
            ;;
        meek)
            bridge_lines=$(grep -iE "^[[:space:]]*meek_lite[[:space:]]+" "$CONFIG_FILE")
            bridge_display_name="meek_lite"
            ;;
        *)
            log_error "Unknown bridge type: $bridge_type"
            return 1
            ;;
    esac
    
    if [[ -z "$bridge_lines" ]]; then
        log_error "No $bridge_display_name bridge found in $CONFIG_FILE"
        log_info "Please add a $bridge_display_name bridge to $CONFIG_FILE"
        log_info "Get bridges from: https://bridges.torproject.org"
        echo ""
        log_info "Example format for $bridge_display_name:"
        case "$bridge_type" in
            obfs4)
                echo "    obfs4 IP:PORT FINGERPRINT cert=CERT iat-mode=0"
                ;;
            snowflake)
                echo "    snowflake IP:PORT FINGERPRINT fingerprint=FP url=URL fronts=FRONTS ice=STUN utls-imitate=TYPE"
                ;;
            meek)
                echo "    meek_lite IP:PORT url=URL front=FRONT utls=TYPE"
                ;;
        esac
        return 1
    fi
    
    local bridge_count=$(echo "$bridge_lines" | wc -l)
    log_success "Found $bridge_count $bridge_display_name bridge(s) in configuration"
    
    return 0
}

# ============================================
# Main Commands
# ============================================
cmd_start() {
    local bridge_type="$1"
    
    show_banner
    
    check_root
    detect_distribution || exit 1
    ACTIVE_BRIDGE="$bridge_type"
    
    if is_running; then
        log_warning "OnionGate is already running"
        log_info "Run 'sudo oniongate stop' first"
        exit 1
    fi
    
    if ! check_dependencies; then
        log_info "Attempting to install required dependencies..."
        install_dependencies
        if ! check_dependencies; then
            log_error "Failed to install dependencies"
            exit 1
        fi
    fi
    
    if [[ -z "$TOR_UID" ]]; then
        log_error "Tor user not found. Please ensure Tor is properly installed."
        exit 1
    fi
    
    log_info "Starting OnionGate..."
    echo ""

    if [[ -n "$bridge_type" ]]; then
        log_info "Validating bridge configuration..."
        if ! validate_bridge_config "$bridge_type"; then
            exit 1
        fi
        echo ""
    fi
    
    create_all_backups
    echo ""
    
    trap cleanup_on_interrupt INT TERM
    
    case "$bridge_type" in
        "")
            configure_torrc_direct
            ;;
        obfs4)
            configure_torrc_obfs4 || exit 1
            ;;
        snowflake)
            configure_torrc_snowflake || exit 1
            ;;
        meek)
            configure_torrc_meek || exit 1
            ;;
        *)
            log_error "Unknown bridge type: $bridge_type"
            exit 1
            ;;
    esac

    append_country_preference

    if [[ -n "$EXIT_COUNTRY" ]]; then
        mkdir -p "$ONIONGATE_DIR/data"
        chown -R "$TOR_USER:$TOR_USER" "$ONIONGATE_DIR/data"
        chmod 700 "$ONIONGATE_DIR/data"
        chown "$TOR_USER:$TOR_USER" "$TORRC_FILE"
        chmod 600 "$TORRC_FILE"
        if ! tor --verify-config -f "$TORRC_FILE" >/dev/null; then
            log_error "Tor configuration validation failed; firewall settings were not changed"
            exit 1
        fi
    fi
    echo ""
    
    if [[ "$SPOOF_MAC" == "true" ]]; then
        spoof_mac_addresses
    else
        log_info "MAC address changes are disabled by default (use --spoof-mac to opt in)"
    fi
    echo ""
    
    configure_iptables
    echo ""
    
    disable_ipv6
    echo ""
    
    configure_dns
    echo ""
    
    if ! start_tor; then
        trap - INT TERM
        log_error "Failed to start Tor. Rolling back changes..."
        restore_all_backups
        enable_ipv6
        exit 1
    fi
    echo ""
    
    trap - INT TERM
    
    echo "running" > "$STATUS_FILE"
    
    log_success "============================================"
    log_success "OnionGate is now active"
    log_success "Supported TCP and DNS traffic is routed through Tor"
    log_success "============================================"
    echo ""
    log_info "To stop OnionGate, run: sudo oniongate stop"
}

cmd_stop() {
    show_banner
    
    check_root
    
    if ! is_running; then
        log_warning "OnionGate is not marked as running; checking for stale OnionGate rules"
        remove_oniongate_firewall
        if [[ -d "$BACKUP_DIR" ]]; then restore_all_backups; fi
        rm -f "$STATUS_FILE"
        exit 0
    fi
    
    log_info "Stopping OnionGate..."
    echo ""
    
    stop_tor
    echo ""
    
    restore_all_backups
    echo ""
    
    enable_ipv6
    echo ""
    
    rm -f "$STATUS_FILE"
    
    log_success "============================================"
    log_success "OnionGate stopped"
    log_success "Original firewall and network settings restored"
    log_success "============================================"
}

cmd_status() {
    show_banner
    
    if is_running; then
        log_success "OnionGate Status: ACTIVE"
        echo ""
        
        local check_result
        check_result=$(curl -s --socks5-hostname 127.0.0.1:$TOR_SOCKS_PORT --max-time 10 https://check.torproject.org/api/ip 2>/dev/null)
        
        if echo "$check_result" | grep -q '"IsTor":true'; then
            local tor_ip
            tor_ip=$(echo "$check_result" | grep -o '"IP":"[^"]*"' | cut -d'"' -f4)
            log_success "Tor Connection: OK"
            log_success "Tor Exit IP: $tor_ip"
        else
            log_error "Tor Connection: FAILED"
            log_warning "Traffic may be leaking!"
        fi
    else
        log_info "OnionGate Status: INACTIVE"
    fi
}

cmd_version() {
    show_banner
    echo "    OnionGate V$VERSION"
    echo ""
}

cmd_help() {
    show_banner
    
    if [[ -f "/etc/oniongate/help.txt" ]]; then
        cat "/etc/oniongate/help.txt"
    else
        cat << 'EOF'
USAGE:
    oniongate <command> [options]

COMMANDS:
    start           Start OnionGate (direct mode)
    stop            Stop OnionGate and restore normal connection
    status          Show OnionGate status
    version         Show version information
    help            Show instructions
    uninstall       Remove OnionGate from system

OPTIONS (used with start):
    -o, --obfs4     Start OnionGate using obfs4 bridge
    -s, --snowflake Start OnionGate using snowflake bridge
    -m, --meek      Start OnionGate using meek_lite bridge
    --country CODE Prefer Tor exits in the specified two-letter country (for example: de)
    -v, --verbose   Show full Tor log output
    --spoof-mac     Opt in to temporary MAC address changes (may disrupt connectivity)

EXAMPLES:
    oniongate start
    oniongate start --obfs4
    oniongate start -s
    oniongate start -v
    oniongate stop

CONFIGURATION:
    Edit /etc/oniongate/oniongate.conf to add your bridge lines.
    
    Example bridge formats:
    
    obfs4:
    obfs4 IP:PORT FINGERPRINT cert=CERT iat-mode=0
    
    snowflake:
    snowflake IP:PORT FINGERPRINT fingerprint=FP url=URL fronts=FRONTS ice=STUN utls-imitate=TYPE
    
    meek_lite:
    meek_lite IP:PORT url=URL front=FRONT utls=TYPE

DEPENDENCIES:
    - tor: Debian: sudo apt install tor  |  Arch: sudo pacman -S tor
    - obfs4proxy: Debian: sudo apt install obfs4proxy  |  Arch: sudo pacman -S obfs4proxy
    - snowflake-client: Debian: sudo apt install snowflake-client  |  Arch: sudo pacman -S snowflake

For more information, see: https://bridges.torproject.org
EOF
    fi
    echo ""
}

cmd_uninstall() {
    show_banner
    
    check_root
    
    log_info "Uninstalling OnionGate..."
    
    if is_running; then
        log_info "Stopping OnionGate first..."
        stop_tor
        restore_all_backups
        rm -f "$STATUS_FILE"
    else
        remove_oniongate_firewall
    fi
    
    log_info "Removing OnionGate files..."
    rm -f /usr/local/bin/oniongate
    rm -f /usr/local/bin/oniongate-gui
    rm -f /usr/local/share/applications/oniongate.desktop
    rm -rf /opt/oniongate/gui /opt/oniongate/venv /opt/oniongate/assets
    rmdir /opt/oniongate 2>/dev/null || true
    
    log_success "OnionGate has been uninstalled"
    log_info "Configuration and data were preserved at $ONIONGATE_DIR"
    log_info "Note: Tor, obfs4proxy, and snowflake-client were not removed"
}

# ============================================
# Main Entry Point
# ============================================
main() {
    local command_name="${1:-}"
    case "$command_name" in
        start)
            shift
            bridge_type=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -o|--obfs4)
                        bridge_type="obfs4"
                        ;;
                    -s|--snowflake)
                        bridge_type="snowflake"
                        ;;
                    -m|--meek)
                        bridge_type="meek"
                        ;;
                    --country)
                        if [[ $# -lt 2 || -z "$2" ]]; then
                            log_error "--country requires a two-letter country code"
                            exit 1
                        fi
                        EXIT_COUNTRY="${2,,}"
                        if [[ ! "$EXIT_COUNTRY" =~ ^[a-z]{2}$ ]]; then
                            log_error "Invalid country code: $2 (expected two letters)"
                            exit 1
                        fi
                        shift
                        ;;
                    -v|--verbose)
                        VERBOSE=true
                        ;;
                    --spoof-mac)
                        SPOOF_MAC=true
                        ;;
                    *)
                        log_error "Unknown option: $1"
                        exit 1
                        ;;
                esac
                shift
            done
            cmd_start "$bridge_type"
            ;;
        stop)
            cmd_stop
            ;;
        status)
            cmd_status
            ;;
        version)
            cmd_version
            ;;
        help|--help|-h)
            cmd_help
            ;;
        uninstall)
            cmd_uninstall
            ;;
        *)
            show_banner
            if [[ -n "$1" ]]; then
                log_error "Unknown command: $1"
            fi
            echo "USAGE:"
            echo "    oniongate <command> [options]"
            echo ""
            echo "COMMANDS:"
            echo "    start           Start OnionGate (direct mode)"
            echo "    stop            Stop OnionGate and restore normal connection"
            echo "    status          Show OnionGate status"
            echo "    version         Show version information"
            echo "    help            Show instructions"
            echo "    uninstall       Remove OnionGate from system"
            echo ""
            echo "OPTIONS (used with start):"
            echo "    -o, --obfs4     Start OnionGate using obfs4 bridge"
            echo "    -s, --snowflake Start OnionGate using snowflake bridge"
            echo "    -m, --meek      Start OnionGate using meek_lite bridge"
            echo "    --country CODE Prefer Tor exits in the specified two-letter country"
            echo "    -v, --verbose   Show full Tor log output"
            echo "    --spoof-mac     Opt in to temporary MAC address changes (may disrupt connectivity)"
            echo ""
            echo "EXAMPLES:"
            echo "    oniongate start"
            echo "    oniongate start --obfs4"
            echo "    oniongate start -s"
            echo "    oniongate start -v"
            echo "    oniongate stop"
            exit 1
            ;;
    esac
}

main "$@"
